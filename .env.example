# PaTan environment configuration.
# Authoritative reference: ENVIRONMENT.md (every var here is read by the code).
# Generate secrets with: openssl rand -base64 32

# ─── Core runtime (required) ────────────────────────────────────────────────
# production throws on boot if SESSION_SECRET is unset. Also signs MFA codes when
# MFA_CODE_SECRET is absent.
SESSION_SECRET=replace-with-a-long-random-secret
# PostgreSQL connection string (read by app + Prisma CLI/migrations)
DATABASE_URL=postgresql://user:pass@localhost:5432/patan?sslmode=require
# Base URL used to build verification/reset email links
APP_ORIGIN=http://localhost:5173
# production enables secure cookies, HSTS, and the SESSION_SECRET fail-fast guard
NODE_ENV=development
# react-router-serve binds to PORT (Dockerfile pins 8080 in production)
PORT=5173

# ─── Email delivery: Resend (primary) ───────────────────────────────────────
# Required for signup verification + password-reset flows (unless webhook fallback set)
RESEND_API_KEY=
AUTH_EMAIL_FROM=PaTan Security <security@notifications.patan.app>

# Email delivery fallback (optional webhook that receives signed email payloads)
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
AUTH_EMAIL_WEBHOOK_KEY_ID=

# ─── Security alerts (optional webhook for high/critical auth events) ───────
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_WEBHOOK_SECRET=
SECURITY_ALERT_WEBHOOK_KEY_ID=

# ─── Notification delivery (optional webhook for in-app fan-out) ────────────
NOTIFICATION_DELIVERY_WEBHOOK_URL=
NOTIFICATION_DELIVERY_WEBHOOK_SECRET=
NOTIFICATION_DELIVERY_WEBHOOK_KEY_ID=

# ─── Bot defense (Turnstile by default) ─────────────────────────────────────
# Any value other than "false" = enabled. Provider: turnstile | recaptcha
BOT_DEFENSE_ENABLED=true
BOT_DEFENSE_PROVIDER=turnstile
BOT_DEFENSE_MIN_SCORE=0.5

# Cloudflare Turnstile (required when BOT_DEFENSE_PROVIDER=turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google reCAPTCHA v2/v3 (required when BOT_DEFENSE_PROVIDER=recaptcha)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Bot challenge thresholds (failed attempts in rolling window)
BOT_CHALLENGE_LOGIN_FAILURE_THRESHOLD=3
BOT_CHALLENGE_SIGNUP_FAILURE_THRESHOLD=2
BOT_CHALLENGE_PASSWORD_RESET_THRESHOLD=2

# ─── Password policy ────────────────────────────────────────────────────────
# Mixed-case/digit/symbol rules are enforced in code and are NOT env-configurable.
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_BREACHED_PASSWORD_CHECK=true

# Auth risk scoring (session score >= threshold is flagged high-risk)
AUTH_HIGH_RISK_SCORE_THRESHOLD=60

# ─── Multi-factor auth ──────────────────────────────────────────────────────
# Distinct secret for TOTP/code signing; falls back to SESSION_SECRET, then dev-mfa-secret
MFA_CODE_SECRET=
AUTH_MFA_CODE_TTL_MS=600000
AUTH_MFA_MAX_ATTEMPTS=5

# ─── Token lifetimes (milliseconds) ─────────────────────────────────────────
# AUTH_EMAIL_VERIFICATION_TTL_MS clamped to 5min–30days
AUTH_EMAIL_VERIFICATION_TTL_MS=86400000
AUTH_PASSWORD_RESET_TTL_MS=3600000

# ─── Email-verification retry worker tuning (positive ints, clamped) ────────
# base delay 5s–1h | max attempts 1–20 | batch 1–200 | loop 5s–10min
# concurrency 1–20 | delivery timeout 2s–2min | run timeout 10s–10min | retention 1–365 days
AUTH_EMAIL_VERIFICATION_RETRY_BASE_DELAY_MS=120000
AUTH_EMAIL_VERIFICATION_RETRY_MAX_ATTEMPTS=6
AUTH_EMAIL_VERIFICATION_RETRY_BATCH_SIZE=20
AUTH_EMAIL_VERIFICATION_RETRY_LOOP_MS=60000
AUTH_EMAIL_VERIFICATION_RETRY_CONCURRENCY=5
AUTH_EMAIL_VERIFICATION_DELIVERY_TIMEOUT_MS=15000
AUTH_EMAIL_VERIFICATION_WORKER_RUN_TIMEOUT_MS=90000
AUTH_EMAIL_VERIFICATION_RETRY_DELIVERED_RETENTION_DAYS=30

# ─── Admin & health ─────────────────────────────────────────────────────────
# Bearer token guarding the email-verification retry-worker health endpoint
ADMIN_EMAIL_VERIFICATION_HEALTH_TOKEN=
# DB liveness probe timeout for /api/health
HEALTH_DB_CHECK_TIMEOUT_MS=2500

# ─── AI service (server-side story suggestions) ─────────────────────────────
# Service is "configured" only when API key AND >=1 endpoint are present.
# Aliases: AZURE_OPENAI_API_KEY -> AI_SERVICE_API_KEY; AZURE_AI_PROJECT_ENDPOINT -> AI_PROJECT_ENDPOINT
AI_SERVICE_API_KEY=
AZURE_OPENAI_API_KEY=
AI_PROJECT_ENDPOINT=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AI_PROJECT_API_VERSION=2024-05-01-preview
AI_MODEL=gpt-4.1-mini
# Tuning (bounded): timeout>0 | retries 0–5 | retry base>0 | output tokens 64–2000
# concurrency 1–64 | circuit open 1–20 | circuit reset>0 | temperature 0–1.5
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=300
AI_MAX_OUTPUT_TOKENS=450
AI_MAX_CONCURRENCY=8
AI_CIRCUIT_OPEN_AFTER_FAILURES=5
AI_CIRCUIT_RESET_MS=45000
AI_TEMPERATURE=0.4

# ─── Rate-limit policy overrides (optional, per scope) ──────────────────────
# Format: AUTH_RATE_LIMIT_<SCOPE>_<DIMENSION>_<FIELD>
# Scopes:   LOGIN, SIGNUP, OAUTH_INIT, OAUTH_CALLBACK, PASSWORD_RESET, MFA, AI_SUGGEST
# Dimensions: IP, IDENTIFIER  (OAUTH_INIT/OAUTH_CALLBACK track IP only)
# Fields:   WINDOW_MS, MAX, BLOCK_MS
# Unset -> defaults from app/utils/rate-limit.server.ts (see ENVIRONMENT.md §11).
# Example:
# AUTH_RATE_LIMIT_LOGIN_IP_WINDOW_MS=900000
# AUTH_RATE_LIMIT_LOGIN_IP_MAX=20
# AUTH_RATE_LIMIT_LOGIN_IP_BLOCK_MS=1800000

# ─── OAuth (Google + Facebook) ──────────────────────────────────────────────
# Only "google" and "facebook" providers are recognized. Each needs all 3 vars.
# Callbacks route to /oauth/callback.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_REDIRECT_URI=http://localhost:5173/oauth/callback
